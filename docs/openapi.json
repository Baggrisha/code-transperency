              }
            ],
            "title": "Contract Id"
          },
          "metadata": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_cases__case_id__documents_post"
      },
      "CaseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CaseCreate"
      },
      "CheckRequest": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "type": "array",
            "maxItems": 300,
            "minItems": 1,
            "title": "Documents"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "delivery_complete": {
            "type": "boolean",
            "title": "Delivery Complete",
            "default": false
          },
          "selected_contract_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Contract Id"
          },
          "manual_links": {
            "items": {
              "$ref": "#/components/schemas/ManualLink"
            },
            "type": "array",
            "title": "Manual Links"
          },
          "required_types": {
            "items": {
              "type": "string",
              "enum": [
                "contract",
                "specification",
                "delivery",
                "acceptance",
                "amendment"
              ]
            },
            "type": "array",
            "title": "Required Types"
          },
          "confidence_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.5,
            "title": "Confidence Threshold",
            "default": 0.9
          },
          "money_tolerance": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Money Tolerance",
            "default": "0.01"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documents",
          "as_of"
        ],
        "title": "CheckRequest"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "contract",
              "specification",
              "delivery",
              "acceptance",
              "amendment"
            ],
            "title": "Type"
          },
          "number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "contract_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Id"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "effective_from": {
            "anyOf": [
