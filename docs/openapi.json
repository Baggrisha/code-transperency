      },
      "Body_upload_api_cases__case_id__documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "document_type": {
            "anyOf": [
              {
                "type": "string",
